{
  "name": "@flagwire/schema",
  "version": "0.1.1",
  "description": "Normative schemas and wire contracts for FlagWire",
  "keywords": [
    "feature-flags",
    "schema",
    "typescript",
    "zod"
  ],
  "license": "MIT",
  "homepage": "https://github.com/flagwire/flagwire-js/tree/main/packages/schema#readme",
  "bugs": {
    "url": "https://github.com/flagwire/flagwire-js/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flagwire/flagwire-js.git",
    "directory": "packages/schema"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --minify --format=esm --platform=neutral --target=es2022 --external:zod --outfile=dist/index.js",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
