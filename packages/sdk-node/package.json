{
  "name": "@flagwire/sdk-node",
  "version": "0.1.2",
  "description": "Local-evaluation Node.js SDK for FlagWire feature flags",
  "keywords": [
    "feature-flags",
    "nodejs",
    "server",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/flagwire/flagwire-js/tree/main/packages/sdk-node#readme",
  "bugs": {
    "url": "https://github.com/flagwire/flagwire-js/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "sideEffects": false,
  "engines": {
    "node": ">=22.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flagwire/flagwire-js.git",
    "directory": "packages/sdk-node"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --minify --format=esm --platform=node --target=node22 --external:@flagwire/evaluate --external:@flagwire/schema --outfile=dist/index.js",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@flagwire/evaluate": "workspace:*",
    "@flagwire/schema": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
