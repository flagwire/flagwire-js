{
  "name": "flagwire-typegen",
  "version": "0.2.0",
  "description": "Generate type-safe FlagWire flag definitions",
  "keywords": [
    "feature-flags",
    "codegen",
    "cli",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/flagwire/flagwire-js/tree/main/tools/typegen-cli#readme",
  "bugs": {
    "url": "https://github.com/flagwire/flagwire-js/issues"
  },
  "type": "module",
  "bin": {
    "flagwire-typegen": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flagwire/flagwire-js.git",
    "directory": "tools/typegen-cli"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json && esbuild src/index.ts --bundle --minify --format=esm --platform=node --target=node20 --outfile=dist/index.js",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "esbuild": "0.28.2"
  }
}
